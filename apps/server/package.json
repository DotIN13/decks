{
	"name": "@decks/server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev": "node --import tsx --watch src/index.ts",
		"start": "node --import tsx src/index.ts",
		"build": "tsc -p tsconfig.json --noEmit",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "node --import tsx --test \"src/**/*.test.ts\"",
		"context": "node --import tsx src/agents/context.check.ts",
		"migrate": "node --import tsx src/migrations/migrate.ts"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.250",
		"@decks/api": "*",
		"@decks/board-kit": "*",
		"@decks/docs": "*",
		"@decks/pen": "*",
		"@decks/protocol": "*",
		"@decks/runtime": "*",
		"@decks/stage": "*",
		"@decks/sync-protocol": "*",
		"@earendil-works/pi-coding-agent": "^1.2.0",
		"@opencode-ai/sdk": "^1.18.29",
		"@opencode/client": "2.0.29",
		"esbuild": "^0.25.0",
		"express": "^5.1.0",
		"parse5": "^7.3.0",
		"playwright": "^1.62.1",
		"typebox": "^1.3.7",
		"ws": "^8.18.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/express": "^5.0.0",
		"@types/node": "^22.19.0",
		"@types/ws": "^8.5.13",
		"tsx": "^4.20.7",
		"typescript": "^5.9.3"
	}
}
