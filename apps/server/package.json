{
  "name": "@decks/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "context": "node --import tsx src/pi/context.check.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.250",
    "@decks/protocol": "*",
    "@earendil-works/pi-coding-agent": "^0.85.0",
    "esbuild": "^0.25.0",
    "express": "^5.1.0",
    "parse5": "^7.3.0",
    "typebox": "^1.3.7",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3"
  }
}
