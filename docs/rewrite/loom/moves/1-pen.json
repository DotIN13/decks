{
	"step": "1-pen",
	"title": "pen/: packages/pen moved to the top, src/ flattened, the name @decks/pen kept",
	"moves": [
		{
			"from": "packages/pen/src/",
			"to": "pen/"
		},
		{
			"from": "packages/pen/",
			"to": "pen/"
		}
	],
	"skip": [
		"apps/",
		"packages/sync-protocol/",
		"packages/sync-client/",
		"packages/agent-ui/",
		"packages/sdk/",
		"packages/docs/src/server/",
		"runtime/",
		"tools/gates/",
		"tools/switch/",
		"docs/rewrite/"
	],
	"mentions": [
		[
			"packages/pen/src/",
			"pen/"
		],
		[
			"packages/pen",
			"pen"
		]
	],
	"paths": [
		{
			"file": "pen/arrow-fixtures.test.ts",
			"replace": [
				{
					"from": "\"../../stage/crates/scene/fixtures/arrows.json\"",
					"to": "\"../packages/stage/crates/scene/fixtures/arrows.json\""
				}
			]
		},
		{
			"file": "pen/colors.test.ts",
			"replace": [
				{
					"from": "\"../../../runtime/skills/canvas-authoring/SKILL.md\"",
					"to": "\"../harness/prompts/skills/canvas-authoring/SKILL.md\""
				},
				{
					"from": "\"../../../runtime/skills/canvas-authoring/colors.md\"",
					"to": "\"../harness/prompts/skills/canvas-authoring/colors.md\""
				},
				{
					"from": "\"../../../runtime/skills/canvas-design/SKILL.md\"",
					"to": "\"../harness/prompts/skills/canvas-design/SKILL.md\""
				}
			]
		},
		{
			"file": "pen/schema.test.ts",
			"replace": [
				{
					"from": "new URL(\"../../../\", import.meta.url)",
					"to": "new URL(\"../\", import.meta.url)"
				}
			]
		},
		{
			"file": "scripts/gen-pen-schema.mjs",
			"replace": [
				{
					"from": "`${root}runtime/skills/canvas-design/schema.md`",
					"to": "`${root}harness/prompts/skills/canvas-design/schema.md`"
				},
				{
					"from": "\"runtime/skills/canvas-design/schema.md is out of date with packages/pen:",
					"to": "\"harness/prompts/skills/canvas-design/schema.md is out of date with pen/:"
				},
				{
					"from": "`${root}packages/pen/src/types.ts`",
					"to": "`${root}pen/types.ts`"
				}
			]
		}
	],
	"keep": [
		{
			"file": "pen/pen.test.ts",
			"string": "../../components.pen",
			"why": "an import inside a drawing the test writes, not a file of the repo"
		}
	],
	"set": [
		{
			"file": "pen/tsconfig.json",
			"values": {
				"include": [
					"**/*.ts"
				]
			}
		},
		{
			"file": "pen/package.json",
			"values": {
				"scripts": {
					"typecheck": "tsc -p tsconfig.json --noEmit",
					"test": "node --import tsx --test \"**/*.test.ts\""
				}
			}
		}
	],
	"workspaces": {
		"add": [
			"pen"
		]
	},
	"create": [
		{
			"file": "pen/README.md",
			"from": "readmes/pen.txt"
		}
	],
	"then": [
		"node tools/heavy.mjs --wait -- npm install",
		"--go re-keys the gate baselines with the files (tools/gates/rekey.mjs) and stages them; node tools/gates/run.mjs --shrink for the keys of deleted or untracked files; commit the baselines with the move",
		"node tools/check.mjs pen && node tools/check.mjs server && node tools/check.mjs harness",
		"node tools/gates/run.mjs",
		"node tools/checks/run.mjs stage-goldens, then stage-shot, then placeholder (one slot each)",
		"commit with REWRITE_AGENT=Loom: Move pen to the top folder pen/"
	]
}
