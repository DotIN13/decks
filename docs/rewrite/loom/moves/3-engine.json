{
	"step": "3-engine",
	"title": "engine/: packages/stage moved whole and named @decks/engine; its built wasm leaves git",
	"moves": [
		{
			"from": "packages/stage/",
			"to": "engine/"
		}
	],
	"skip": [
		"apps/",
		"packages/sync-protocol/",
		"packages/sync-client/",
		"packages/agent-ui/",
		"packages/sdk/",
		"packages/docs/src/server/",
		"runtime/",
		"tools/gates/",
		"tools/switch/",
		"docs/rewrite/"
	],
	"specifiers": {
		"@decks/stage": "@decks/engine"
	},
	"mentions": [
		[
			"packages/stage/",
			"engine/"
		],
		[
			"packages/stage",
			"engine"
		]
	],
	"untrack": [
		"packages/stage/pkg/",
		"packages/stage/pkg-gl/"
	],
	"ignore": [
		{
			"file": "engine/.gitignore",
			"add": [
				"pkg/",
				"pkg-gl/"
			]
		}
	],
	"paths": [
		{
			"file": "server/pictures/native.ts",
			"replace": [
				{
					"from": "\"../../packages/stage/target/release/stage-shot\"",
					"to": "\"../../engine/target/release/stage-shot\""
				}
			]
		},
		{
			"file": "tools/checks/pictures/stage-shot.mjs",
			"replace": [
				{
					"from": "\"../../../packages/stage/target/release/stage-shot\"",
					"to": "\"../../../engine/target/release/stage-shot\""
				}
			]
		},
		{
			"file": "pen/arrow-fixtures.test.ts",
			"replace": [
				{
					"from": "\"../packages/stage/crates/scene/fixtures/arrows.json\"",
					"to": "\"../engine/crates/scene/fixtures/arrows.json\""
				}
			]
		},
		{
			"file": "engine/demo/serve.mjs",
			"replace": [
				{
					"from": "\"../../../data/decks\"",
					"to": "\"../../data/decks\""
				}
			]
		},
		{
			"file": "apps/web/scripts/stage-backends.ts",
			"replace": [
				{
					"from": "\"../../../packages/stage\"",
					"to": "\"../../../engine\""
				},
				{
					"from": "no fonts in packages/stage/fonts:",
					"to": "no fonts in engine/fonts:"
				}
			]
		},
		{
			"file": "tools/checks/library/stage-goldens.mjs",
			"replace": [
				{
					"from": "join(web, \"../../packages/stage\")",
					"to": "join(web, \"../../engine\")"
				}
			]
		},
		{
			"file": "engine/crates/apple/tests/common/mod.rs",
			"replace": [
				{
					"from": "\"{}/../../../../tools/fixtures/drawings/{name}.{ext}\"",
					"to": "\"{}/../../../tools/fixtures/drawings/{name}.{ext}\""
				}
			],
			"why": "the crate's own path to the repo's fixtures: one folder less to climb from engine/ than from packages/stage/"
		}
	],
	"set": [
		{
			"file": "engine/package.json",
			"values": {
				"name": "@decks/engine"
			}
		}
	],
	"workspaces": {
		"add": [
			"engine"
		]
	},
	"create": [
		{
			"file": "engine/README.md",
			"from": "readmes/engine.txt"
		},
		{
			"file": "engine/crates/README.md",
			"from": "readmes/engine-crates.txt"
		},
		{
			"file": "engine/demo/README.md",
			"from": "readmes/engine-demo.txt"
		},
		{
			"file": "engine/fonts/README.md",
			"from": "readmes/engine-fonts.txt"
		}
	],
	"then": [
		"before: Anvil between commits, told its lane is now engine/crates/apple/, engine/Cargo.toml, engine/Cargo.lock",
		"node tools/heavy.mjs --wait -- npm install",
		"node tools/heavy.mjs --wait -- npm run build:wasm -w @decks/engine (pkg/ and pkg-gl/ from source, as a fresh checkout must)",
		"--go re-keys the gate baselines with the files (tools/gates/rekey.mjs) and stages them; node tools/gates/run.mjs --shrink for the keys of deleted or untracked files; commit the baselines with the move",
		"node tools/check.mjs canvas (still packages/canvas) && node tools/check.mjs server",
		"node tools/gates/run.mjs",
		"node tools/heavy.mjs --wait -- cargo test --manifest-path engine/Cargo.toml",
		"node tools/checks/run.mjs backends, tile-pixels, stage-goldens, layers-webkit (one slot each)",
		"tell Slate (decks-ios: scripts/build-engine.sh, scripts/fetch-fonts.sh, DrawTests.swift) and Loft (decks-studio: page/package.json) the new path and name",
		"commit with REWRITE_AGENT=Loom: Move the engine to engine/ as @decks/engine, built not kept"
	]
}
