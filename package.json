{
  "name": "decks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A canvas-centric coding agent: boards are local HTML files on an infinite canvas, written by an agent and edited by hand",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DotIN13/decks.git"
  },
  "homepage": "https://github.com/DotIN13/decks#readme",
  "bugs": {
    "url": "https://github.com/DotIN13/decks/issues"
  },
  "keywords": [
    "agent",
    "coding-agent",
    "canvas",
    "boards",
    "html",
    "pi",
    "claude-code"
  ],
  "workspaces": [
    "packages/*",
    "apps/*",
    "runtime",
    "extension",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently --raw --kill-others-on-fail \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "DECKS_DATA_DIR=\"${DECKS_DATA_DIR:-$PWD/data}\" npm run dev --workspace @decks/server",
    "dev:web": "npm run dev --workspace @decks/web",
    "e2e:serve": "concurrently --raw --kill-others-on-fail \"npm:e2e:serve:server\" \"npm:dev:web\"",
    "e2e:serve:server": "DECKS_DATA_DIR=\"${DECKS_DATA_DIR:-$PWD/data}\" npm run start --workspace @decks/server",
    "build": "npm run build --workspace @decks/server && npm run build --workspace @decks/web",
    "start": "DECKS_DATA_DIR=\"${DECKS_DATA_DIR:-$PWD/data}\" npm run start --workspace @decks/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test scripts/*.test.mjs",
    "vendor": "node scripts/vendor.mjs",
    "css:order": "node scripts/css-order.mjs",
    "dev:example": "DECKS_DATA_DIR=\"$PWD/example\" npm run dev --workspace @decks/server",
    "test:e2e": "node e2e/run.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "d3": "^7.9.0",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.11",
    "marked": "^15.0.12",
    "mermaid": "^11.6.0",
    "pdfjs-dist": "^5.4.149",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
