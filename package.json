{
  "name": "decks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A canvas-centric coding agent: cards, drawings, documents and apps on an infinite canvas, written by agents as local files and edited by hand",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DotIN13/decks.git"
  },
  "homepage": "https://github.com/DotIN13/decks#readme",
  "bugs": {
    "url": "https://github.com/DotIN13/decks/issues"
  },
  "keywords": [
    "agent",
    "coding-agent",
    "canvas",
    "cards",
    "html",
    "pi",
    "claude-code"
  ],
  "workspaces": [
    "packages/*",
    "examples/*",
    "protocol",
    "server",
    "harness",
    "harness/page",
    "clients/*",
    "tools"
  ],
  "scripts": {
    "dev": "node --import tsx server/main.ts --deck \"${DECKS_DECK:-$PWD/data}\" & node --import tsx harness/main.ts --deck \"${DECKS_DECK:-$PWD/data}\"",
    "start": "node --import tsx server/main.ts --deck \"${DECKS_DECK:-$PWD/data}\"",
    "build:page": "npm run build --workspace @decks/page",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node tools/check.mjs protocol && node tools/check.mjs server && node tools/check.mjs harness && node tools/check.mjs tools",
    "gates": "node tools/gates/run.mjs",
    "test:e2e": "node tools/checks/run.mjs",
    "check": "node tools/check.mjs",
    "heavy": "node tools/heavy.mjs",
    "vendor": "node scripts/vendor.mjs",
    "build:live-doc": "node scripts/live-doc.mjs",
    "build:packages": "node scripts/build-packages.mjs",
    "test:packages": "node scripts/test-packages.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "d3": "^7.9.0",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.11",
    "marked": "^15.0.12",
    "mermaid": "^11.6.0",
    "pdfjs-dist": "^5.4.149",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
