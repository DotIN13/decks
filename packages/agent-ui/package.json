{
	"name": "@decks/agent-ui",
	"version": "0.1.0",
	"description": "The agent parts of a Decks editor: the conversation, the composer with its queue, and alerts with their sounds, for any host that runs agents",
	"license": "MIT",
	"type": "module",
	"exports": {
		"./chat": "./src/public/chat.ts",
		"./composer": "./src/public/composer.ts",
		"./alerts": "./src/public/alerts.ts",
		"./edge": "./src/edge.ts",
		"./vite": {
			"types": "./vite-plugin.d.mts",
			"default": "./vite-plugin.mjs"
		},
		"./styles/*": "./styles/*"
	},
	"files": [
		"src",
		"sounds",
		"vite-plugin.mjs",
		"vite-plugin.d.mts",
		"styles"
	],
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "node --import tsx --test \"src/**/*.test.ts\""
	},
	"dependencies": {
		"@decks/protocol": "*",
		"@decks/ui": "*",
		"lucide-solid": "^1.37.0",
		"solid-js": "^1.9.14"
	},
	"devDependencies": {
		"tsx": "^4.20.7",
		"typescript": "^5.9.3"
	}
}
