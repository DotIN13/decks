 {
  "name": "newBoard",
  "command": [
   "new-board"
  ],
  "group": "boards",
  "effect": "change",
  "summary": "Write a blank board and return its path. The title is the finding, as a sentence. `format` \"board\" (default) is one HTML page you design; \"slides\" is a reveal deck of <section>s. `at` is its top-left corner on your stage: say it every time, after reading the stage with pen.read. Left out, the board goes beside your newest board and the result says where.",
  "signature": "newBoard(options: { title: string; format?: \"board\" | \"slides\"; w?: number; h?: number; at?: Corner })",
  "returns": "string",
  "params": [
   {
    "name": "options",
    "type": "{ title: string; format?: \"board\" | \"slides\"; w?: number; h?: number; at?: Corner }",
    "schema": {
     "type": "object",
     "properties": {
      "title": {
       "type": "string"
      },
      "format": {
       "enum": [
        "board",
        "slides"
       ]
      },
      "w": {
       "type": "number"
      },
      "h": {
       "type": "number"
      },
      "at": {
       "anyOf": [
        {
         "type": "object",
         "properties": {
          "x1": {
           "type": "number"
          },
          "y1": {
           "type": "number"
          }
         },
         "required": [
          "x1",
          "y1"
         ],
         "additionalProperties": false
        },
        {
         "type": "object",
         "properties": {
          "x": {
           "type": "number"
          },
          "y": {
           "type": "number"
          }
         },
         "required": [
          "x",
          "y"
         ],
         "additionalProperties": false
        }
       ],
       "description": "A board's top-left corner on the stage: { x1, y1 }, or { x, y }."
      }
     },
     "required": [
      "title"
     ],
     "additionalProperties": false
    }
   }
  ]
 },
