e":"path","id":"xPp6o","name":"Ink","x":9844,"y":138809,"width":29,"height":16,"viewBox":[0,0,29,16],"geometry":"M5.6 4.5Q5 4.1 14.8 7.9L24.6 11.6","stroke":"$decks-ink","strokeWidth":4,"strokeLinecap":"round","strokeLinejoin":"round","metadata":{"type":"decks.ink","tool":"pen","color":"ink","size":4,"points":[5.6,4.5,0.5,5,4.1,0.5,24.6,11.6,0.5]}},{"type":"path","id":"T9RWZ","name":"Ink","x":9709,"y":138843,"width":24,"height":36,"viewBox":[0,0,24,36],"geometry":"M8 4.4Q18.2 4.4 17.4 5.5Q16.5 6.5 15 9.6Q13.4 12.6 11.1 20.4Q8.8 28.1 7.9 29.5Q7 30.8 5.9 31.3Q4.7 31.7 7.8 31.1Q10.9 30.4 12.3 30.4Q13.7 30.4 16.8 31L19.8 31.6","stroke":"$decks-ink","strokeWidth":4,"strokeLinecap":"round","strokeLinejoin":"round","metadata":{"type":"decks.ink","tool":"pen","color":"ink","size":4,"points":[8,4.4,0.5,18.2,4.4,0.5,16.5,6.5,0.5,13.4,12.6,0.5,8.8,28.1,0.5,7,30.8,0.5,4.7,31.7,0.5,10.9,30.4,0.5,13.7,30.4,0.5,19.8,31.6,0.5]}},{"type":"path","id":"rBGk5","name":"Ink","x":9744,"y":138842,"width":24,"height":41,"viewBox":[0,0,24,41],"geometry":"M11.2 5.3Q11.2 4.8 8.6 12.2Q6 19.6 5.3 23.6Q4.5 27.5 4.6 29.6Q4.7 31.6 5.3 32.8Q5.9 34 7.6 34.2Q9.2 34.3 11 33.1Q12.7 31.9 15.3 29.3Q17.8 26.7 17.3 28.8Q16.8 30.8 16.7 32.4Q16.6 33.9 17.2 34.8Q17.7 35.7 18.5 36L19.2 36.3","stroke":"$decks-ink","strokeWidth":4,"strokeLinecap":"round","strokeLinejoin":"round","metadata":{"type":"decks.ink","tool":"pen","color":"ink","size":4,"points":[11.2,5.3,0.5,11.2,4.8,0.5,6,19.6,0.5,4.5,27.5,0.5,4.7,31.6,0.5,5.9,34,0.5,9.2,34.3,0.5,12.7,31.9,0.5,17.8,26.7,0.5,16.8,30.8,0.5,16.6,33.9,0.5,17.7,35.7,0.5,19.2,36.3,0.5]}},{"type":"path","id":"QX87x","name":"Ink","x":9759,"y":138853,"width":11,"height":14,"viewBox":[0,0,11,14],"geometry":"M6.2 9.3Q4.8 4.2 5.2 5.1Q5.5 6 6 6.5L6.5 6.9","stroke":"$decks-ink","strokeWidth":4,"strokeLinecap":"round","strokeLinejoin":"round","metadata":{"type":"decks.ink","tool":"pen","color":"ink","size":4,"points":[6.2,9.3,0.5,4.8,4.2,0.5,5.5,6,0.5,6.5,6.9,0.5]}},{"type":"path","id":"LEwj3","name":"Ink","x":9769,"y":138841,"width":13,"height":38,"viewBox":[0,0,13,38],"geometry":"M8 5.4Q8.3 4.5 6.7 14Q5 23.4 4.9 27.5Q4.7 31.5 5.1 32.5L5.5 33.4","stroke":"$decks-ink","strokeWidth":4,"strokeLinecap":"round","strokeLinejoin":"round","metadata":{"type":"decks.ink","tool":"pen","color":"ink","size":4,"points":[8,5.4,0.5,8.3,4.5,0.5,5,23.4,0.5,4.7,31.5,0.5,5.5,33.4,0.5]}},{"type":"path","id":"7XKT3","name":"Ink","x":9773,"y":138859,"width":24,"height":15,"viewBox":[0,0,24,15],"geometry":"M18.7 5.3Q19.9 5 15.7 5.5Q11.5 6 9.9 6.4Q8.3 6.8 6.7 7.5Q5 8.2 5.5 8.6Q6 9 11 9.8L16 10.6","stroke":"$decks-ink","strokeWidth":4,"strokeLinecap":"round","strokeLinejoin":"round","metadata":{"type":"decks.ink","tool":"pen","color":"ink","size":4,"points":[18.7,5.3,0.5,19.9,5,0.5,11.5,6,0.5,8.3,6.8,0.5,5,8.2,0.5,6,9,0.5,16,10.6,0.5]}},{"type":"path","id":"MqzLV","name":"Ink","x":9790,"y":138859,"width":22,"height":20,"viewBox":[0,0,22,20],"geometry":"M4.6 11.4Q10.7 12.1 12.6 11.5Q14.5 10.9 15.6 10.1Q16.7 9.2 17.2 8.5Q17.6 7.7 17.6 7Q17.6 6.2 17.2 5.6Q16.7 5 16 4.7Q15.3 4.4 13.8 4.3Q12.3 4.2 10.5 5.1Q8.7 6 7.3 7.6Q5.9 9.2 5.5 11.1Q5.1 12.9 5.7 13.6Q6.3 14.2 7.3 14.6Q8.3 15 10.7 15.2Q13.1 15.3 15 14.9L16.8 14.5","stroke":"$decks-ink","strokeWidth":4,"strokeLinecap":"round","strokeLinejoin":"round","metadata":{"type":"decks.ink","tool":"pen","color":"ink","size":4,"points":[4.6,11.4,0.5,10.7,12.1,0.5,14.5,10.9,0.5,16.7,9.2,0.5,17.6,7.7,0.5,17.6,6.2,0.5,16.7,5,0.5,15.3,4.4,0.5,12.3,4.2,0.5,8.7,6,0.5,5.9,9.2,0.5,5.1,12.9,0.5,6.3,14.2,0.5,8.3,15,0.5,13.1,15.3,0.5,16.8,14.5,0.5]}},{"type":"text","id":"outline3-title","content":"Outline v3, from your notes (yellow = changed since v2, green = the TD card you flagged)","fontSize":40,"fontWeight":"700","fill":"#6b7280","x":7869,"y":139660},{"type":"frame","id":"outline3","layout":"horizontal","gap":28,"alignItems":"start","children":[{"type":"frame","id":"ol3-c0","layout":"vertical","gap":14,"width":300,"children":[{"type":"text","id":"ol3-c0-h","content":"Cold open","fontSize":22,"fontWeight":"700","fill":"#6b7280","textGrowth":"fixed-width","width":300},{"type":"note","id":"ol3-c0-p0","width":300,"metadata":{"type":"decks.markdown"},"content":"**0:00** A robot lost in a Minecraft maze hunts for cake, with zombies and skeletons waiting in the dark"},{"type":"note","id":"ol3-c0-p1","width":300,"metadata":{"type":"decks.markdown"},"content":"**0:50** The maze becomes an MDP. Each room is a **state**, each move an **action**, and cake (+10) and zombie (−10) are **rewards**"},{"type":"note","id":"ol3-c0-p2","width":300,"metadata":{"type":"decks.markdown"},"content":"The long title folds into its letters: **MDP**"}]},{"type":"frame","id":"ol3-c1","layout":"vertical","gap":14,"width":300,"children":[{"type":"text","id":"ol3-c1-h","content":"The goal, and why brute force fails","fontSize":22,"fontWeight":"700","fill":"#6b7280","textGrowth":"fixed-width","width":300},{"type":"note","id":"ol3-c1-p0","width":300,"metadata":{"type":"decks.markdown"},"content":"A **policy** picks an action in every state, and finding the best one is the goal"},{"type":"note","id":"ol3-c1-p1","width":300,"metadata":{"type":"decks.markdown"},"content":"The obvious try: test all 4^7 = **16,384** policies and keep the best"},{"type":"note","id":"ol3-c1-p2","width":300,"metadata":{"type":"decks.markdown"},"content":"It doesn't scale: chess has about 10^44 states, Go 10^170. And it's wasteful: near-identical policies judged from scratch"},{"type":"note","id":"ol3-c1-p3","width":300,"metadata":{"type":"decks.markdown"},"content":"**So we need cleverer ways**, in two groups: Part 1 knows the MDP's rules, the state transition probabilities (**model-based**), Part 2 doesn't (**model-free**)"}]},{"type":"frame","id":"ol3-c2","layout":"vertical","gap":14,"width":300,"children":[{"type":"text","id":"ol3-c2-h","content":"Part 1 · Policy iteration","fontSize":22,"fontWeight":"700","fill":"#3b82f6","textGrowth":"fixed-width","width":300},{"type":"note","id":"ol3-c2-p0","width":300,"metadata":{"type":"decks.markdown"},"content":"The **model**: where each action leads (**transitions**) and what it pays. Picture it as the map, once, then call it the model"},{"type":"note","id":"ol3-c2-p1","width":300,"metadata":{"type":"decks.markdown"},"content":"**Value** V(s): the reward you can expect from a state, with each step discounted by γ = 0.9"},{"type":"note","id":"ol3-c2-p2","width":300,"metadata":{"type":"decks.markdown"},"content":"**Dynamic programming**: break \"what is this state worth?\" into \"what is the next state worth?\", and reuse each answer instead of replaying whole paths","fill":"#FFF1B8"},{"type":"note","id":"ol3-c2-p3","width":300,"metadata":{"type":"decks.markdown"},"content":"**Policy evaluation**: start every V(s) at 0, then sweep V(s) = r + γ V(s′) for the policy's action, weighted by the transition probabilities, until nothing changes","fill":"#FFF1B8"},{"type":"note","id":"ol3-c2-p4","width":300,"metadata":{"type":"decks.markdown"},"content":"**Policy improvement**: in each state, look one step ahead with the model and switch to the action with the highest r + γ V(s′)","fill":"#FFF1B8"},{"type":"note","id":"ol3-c2-p5","width":300,"metadata":{"type":"decks.markdown"},"content":"Round 1 evaluates \"always up\". 2 actions switch, then 2 more. Round 3 changes nothing: the **optimal policy**","fill":"#FFF1B8"}]},{"type":"frame","id":"ol3-c3","layout":"vertical","gap":14,"width":300,"children":[{"type":"text","id":"ol3-c3-h","content":"Part 1 · Value iteration","fontSize":22,"fontWeight":"700","fill":"#3b82f6","textGrowth":"fixed-width","width":300},{"type":"note","id":"ol3-c3-p0","width":300,"metadata":{"type":"decks.markdown"},"content":"**Bellman equation**: V(s) = the best action's reward + γ × V(next state)"},{"type":"note","id":"ol3-c3-p1","width":300,"metadata":{"type":"decks.markdown"},"content":"Also dynamic programming, with a shortcut: cut policy evaluation to **one sweep** and take the max over actions straight away","fill":"#FFF1B8"},{"type":"note","id":"ol3-c3-p2","width":300,"metadata":{"type":"decks.markdown"},"content":"Apply it to every state, one **sweep** at a time: 10, 9, 8.1… converged in 4 sweeps"},{"type":"note","id":"ol3-c3-p3","width":300,"metadata":{"type":"decks.markdown"},"content":"The **greedy policy** takes the highest-value action in each state. Both Part 1 methods need the model (and the robot eats the cake)"}]},{"type":"frame","id":"ol3-c4","layout":"vertical","gap":14,"width":300,"children":[{"type":"text","id":"ol3-c4-h","content":"Part 2 · Monte Carlo (s11 + s12, now one scene)","fontSize":22,"fontWeight":"700","fill":"#e8590c","textGrowth":"fixed-width","width":300},{"type":"note","id":"ol3-c4-p0","width":300,"metadata":{"type":"decks.markdown"},"content":"In many real problems the next state **can't be predicted**: a self-driving car, a robot hand, a language model, and **where this zombie will go**","fill":"#FFF1B8"},{"type":"note","id":"ol3-c4-p1","width":300,"metadata":{"type":"decks.markdown"},"content":"Without the transition probabilities, model-based methods are **simply impossible**","fill":"#FFF1B8"},{"type":"note","id":"ol3-c4-p2","width":300,"metadata":{"type":"decks.markdown"},"content":"So Monte Carlo gets around it: the agent learns by **exploring the world itself**, instead of reading a model","fill":"#FFF1B8"},{"type":"note","id":"ol3-c4-p3","width":300,"metadata":{"type":"decks.markdown"},"content":"Start with a policy: a **random** one, every action equally likely","fill":"#FFF1B8"},{"type":"note","id":"ol3-c4-p4","width":300,"metadata":{"type":"decks.markdown"},"content":"**Evaluate**: play whole **episodes** and average their **returns**: 5.9, −8.1, 7.29…","fill":"#FFF1B8"},{"type":"note","id":"ol3-c4-p5","width":300,"metadata":{"type":"decks.markdown"},"content":"**Improve**: better actions get more likely, others still tried (**exploration**). Repeat: policy iteration with real returns in place of the model","fill":"#FFF1B8"}]},{"type":"frame","id":"ol3-c5","layout":"vertical","gap":14,"width":300,"children":[{"type":"text","id":"ol3-c5-h","content":"Part 2 · TD and Q-learning","fontSize":22,"fontWeight":"700","fill":"#e8590c","textGrowth":"fixed-width","width":300},{"type":"note","id":"ol3-c5-p0","width":300,"metadata":{"type":"decks.markdown"},"content":"★ **TD**: after each step, move V(s) toward r + γ V(s′), the **TD target**. Give it its own beat: a reward and a guess, instead of a whole episode","fill":"#D3F9D8"},{"type":"note","id":"ol3-c5-p1","width":300,"metadata":{"type":"decks.markdown"},"content":"With a learning rate of ½, one update from 0 toward 10 gives 5. Estimates **bootstrap** from estimates, outward from the cake"},{"type":"note","id":"ol3-c5-p2","width":300,"metadata":{"type":"decks.markdown"},"content":"Up from the start has two next states: ¾ the empty one (8.1), ¼ the **terminal** zombie state (−10). So Q(s, up) is about 3, Q(s, right) about 7"},{"type":"note","id":"ol3-c5-p3","width":300,"metadata":{"type":"decks.markdown"},"content":"**Q-learning**: move Q(s, a) toward r + γ max Q(s′, a′). The max makes it **value iteration from Part 1** without the model (Watkins, 1989)"}]},{"type":"frame","id":"ol3-c6","layout":"vertical","gap":14,"width":300,"children":[{"type":"text","id":"ol3-c6-h","content":"The family","fontSize":22,"fontWeight":"700","fill":"#6b7280","textGrowth":"fixed-width","width":300},{"type":"note","id":"ol3-c6-p0","width":300,"metadata":{"type":"decks.markdown"},"content":"The two-by-two: model-based or model-free, down; policy iteration or value iteration, across. MC and TD sit under PI, Q-learning under VI"},{"type":"note","id":"ol3-c6-p1","width":300,"metadata":{"type":"decks.markdown"},"content":"Every method searches for the **optimal policy**, learning from the gap between expected and received reward"},{"type":"note","id":"ol3-c6-p2","width":300,"metadata":{"type":"decks.markdown"},"content":"**All modern AI learns this way.** Maybe we do too?"}]},{"type":"frame","id":"ol3-c7","layout":"vertical","gap":14,"width":300,"children":[{"type":"text","id":"ol3-c7-h","content":"Coda","fontSize":22,"fontWeight":"700","fill":"#d92e3c","textGrowth":"fixed-width","width":300},{"type":"note","id":"ol3-c7-p0","width":300,"metadata":{"type":"decks.markdown"},"content":"Blackout, glowing eyes, lightning: **Herobrine** on a hill with an enchanted diamond sword"},{"type":"note","id":"ol3-c7-p1","width":300,"metadata":{"type":"decks.markdown"},"content":"“Learn… or die.” Glitch, then black"}]}],"x":7869,"y":139740},{"type":"browser","id":"keep-policy-iteration-first-it-follows","name":"Keep policy iteration first: it follows straight from brute force, and makes value iteration read as its shortcut","url":"../../boards/keep-policy-iteration-first-it-follows-straight.html","width":1000,"height":563,"metadata":{"type":"decks.board","path":"boards/keep-policy-iteration-first-it-follows-straight.html"},"x":12669,"y":136653},{"type":"browser","id":"the-v3-script-brute-force-sets-up-four","name":"The v3 script: brute force sets up four ways, policy iteration comes first, and the film runs 15m12s","url":"../../boards/the-v3-script-brute-force-sets-up-four-ways-poli.html","width":1100,"height":1073,"metadata":{"type":"decks.board","path":"boards/the-v3-script-brute-force-sets-up-four-ways-poli.html"},"x":13829,"y":136653},{"type":"browser","id":"the-v3-rewrite-is-built-15m45s-across","name":"The v3 rewrite is built: 15m45s across six chapters, ready to watch in the Studio preview","url":"../../boards/the-v3-rewrite-is-built-15m45s-across-six-chapte.html","width":1100,"height":789,"metadata":{"type":"decks.board","path":"boards/the-v3-rewrite-is-built-15m45s-across-six-chapte.html"},"x":15089,"y":136653},{"type":"browser","id":"the-preview-does-play-sound-measured-at","name":"The preview does play sound: measured at about -20 dB, so reload the Studio tab","url":"../../boards/the-previ