dth":28,"height":38,"viewBox":[0,0,28,38],"geometry":"M11 21.5Q12.1 22.3 12.9 22.3Q13.6 22.3 14.4 21.9Q15.2 21.5 18.1 19Q21 16.5 22.2 14.4Q23.4 12.2 23.4 10.5Q23.4 8.8 22.9 7.9Q22.4 7 21.2 6.2Q20 5.4 18 4.9Q15.9 4.3 13.7 4.4Q11.5 4.6 9.4 5.7Q7.3 6.7 6.2 8.1Q5 9.5 5 11.1Q5 12.6 6.1 14.5Q7.1 16.3 12.8 23.2Q18.4 30 18.5 31.1Q18.7 32.1 17 32.8Q15.3 33.4 11.3 33.3Q7.3 33.1 7.4 32.1Q7.5 31 9 29.3Q10.4 27.6 12.2 26.3Q13.9 25 16.4 23.7L18.9 22.3","stroke":"$decks-ink","strokeWidth":4,"strokeLinecap":"round","strokeLinejoin":"round","metadata":{"type":"decks.ink","tool":"pen","color":"ink","size":4,"points":[11,21.5,0.5,12.1,22.3,0.5,13.6,22.3,0.5,15.2,21.5,0.5,21,16.5,0.5,23.4,12.2,0.5,23.4,8.8,0.5,22.4,7,0.5,20,5.4,0.5,15.9,4.3,0.5,11.5,4.6,0.5,7.3,6.7,0.5,5,9.5,0.5,5,12.6,0.5,7.1,16.3,0.5,18.4,30,0.5,18.7,32.1,0.5,15.3,33.4,0.5,7.3,33.1,0.5,7.5,31,0.5,10.4,27.6,0.5,13.9,25,0.5,18.9,22.3,0.5]}},{"type":"path","id":"ZDvCP","name":"Ink","x":10531,"y":136223,"width":14,"height":11,"viewBox":[0,0,14,11],"geometry":"M4.6 4.1L9.3 6.9","stroke":"$decks-ink","strokeWidth":4,"strokeLinecap":"round","strokeLinejoin":"round","metadata":{"type":"decks.ink","tool":"pen","color":"ink","size":4,"points":[4.6,4.1,0.5,9.3,6.9,0.5]}},{"type":"path","id":"t3DOK","name":"Ink","x":10544,"y":136200,"width":10,"height":31,"viewBox":[0,0,10,31],"geometry":"M5.8 4.6Q5.5 12.9 5 16.7Q4.5 20.4 4.5 23.5L4.5 26.7","stroke":"$decks-ink","strokeWidth":4,"strokeLinecap":"round","strokeLinejoin":"round","metadata":{"type":"decks.ink","tool":"pen","color":"ink","size":4,"points":[5.8,4.6,0.5,5.5,12.9,0.5,4.5,20.4,0.5,4.5,26.7,0.5]}},{"type":"browser","id":"the-first-minute-at-14-2-lufs-with","name":"The first minute at -14.2 LUFS with narration 4 dB ahead, for a listen before the full render","url":"../../boards/the-first-minute-at-14-2-lufs-with-narration-4-d.html","width":1000,"height":699,"metadata":{"type":"decks.board","path":"boards/the-first-minute-at-14-2-lufs-with-narration-4-d.html"},"x":8986,"y":135868},{"type":"browser","id":"rendering-is-2x-faster-with-4-workers","name":"Rendering is 2x faster with 4 workers and streaming off: about 13 minutes for the film instead of 26","url":"../../boards/rendering-is-2x-faster-with-4-workers-and-stream.html","width":1000,"height":520,"metadata":{"type":"decks.board","path":"boards/rendering-is-2x-faster-with-4-workers-and-stream.html"},"x":10289,"y":135263},{"type":"browser","id":"4k-with-streaming-off-is-possible-but","name":"4K with streaming off is possible, but the renderer's disk check needs about 13 GB more free space first","url":"../../boards/4k-with-streaming-off-is-possible-but-the-render.html","width":1000,"height":460,"metadata":{"type":"decks.board","path":"boards/4k-with-streaming-off-is-possible-but-the-render.html"},"x":7869,"y":136023},{"type":"browser","id":"the-4k-60-fps-film-is-rendered-13m05s-1","name":"The 4K 60 fps film is rendered: 13m05s, 1.2 GB, at -14.2 LUFS, in 62 minutes","url":"../../boards/the-4k-60-fps-film-is-rendered-13m05s-1-2-gb-at.html","width":1000,"height":720,"metadata":{"type":"decks.board","path":"boards/the-4k-60-fps-film-is-rendered-13m05s-1-2-gb-at.html"},"x":8986,"y":136653},{"type":"browser","id":"draft-ending-one-map-of-the-family-then","name":"Draft ending: one map of the family, then the robot's learned policy, which now goes right around the zombie","url":"../../boards/draft-ending-one-map-of-the-family-then-the-robo.html","width":1160,"height":947,"metadata":{"type":"decks.board","path":"boards/draft-ending-one-map-of-the-family-then-the-robo.html"},"x":10189,"y":136653},{"type":"browser","id":"the-empty-top-left-is-policy-iteration","name":"Policy iteration judges a policy, fixes its arrows, and repeats; the film already names it, so the ending only needs to fill the cell","url":"../../boards/the-empty-top-left-is-policy-iteration-with-the.html","width":1000,"height":650,"metadata":{"type":"decks.board","path":"boards/the-empty-top-left-is-policy-iteration-with-the.html"},"x":11509,"y":136653},{"type":"frame","id":"outline","layout":"horizontal","gap":28,"alignItems":"start","padding":[0,0],"children":[{"type":"frame","id":"ol-c0","layout":"vertical","gap":14,"width":300,"children":[{"type":"text","id":"ol-c0-h","content":"Cold open · 0:00","fontSize":22,"fontWeight":"700","fill":"#6b7280","textGrowth":"fixed-width","width":300},{"type":"note","id":"ol-c0-p0","width":300,"metadata":{"type":"decks.markdown"},"content":"**0:00** A robot lost in a Minecraft maze hunts for cake, with zombies and skeletons waiting in the dark"},{"type":"note","id":"ol-c0-p1","width":300,"metadata":{"type":"decks.markdown"},"content":"**0:50** The maze becomes an MDP: 7 rooms (states), 4 moves (actions), +10 cake and −10 zombie (rewards)"},{"type":"note","id":"ol-c0-p2","width":300,"metadata":{"type":"decks.markdown"},"content":"The long title folds into its letters: **MDP**"}]},{"type":"frame","id":"ol-c1","layout":"vertical","gap":14,"width":300,"children":[{"type":"text","id":"ol-c1-h","content":"The goal: a policy · 1:41","fontSize":22,"fontWeight":"700","fill":"#6b7280","textGrowth":"fixed-width","width":300},{"type":"note","id":"ol-c1-p0","width":300,"metadata":{"type":"decks.markdown"},"content":"A **policy** is one arrow in every square, and finding the best one is the goal"},{"type":"note","id":"ol-c1-p1","width":300,"metadata":{"type":"decks.markdown"},"content":"Four ways to find it, in two groups: **Part 1** has the map, **Part 2** does not"}]},{"type":"frame","id":"ol-c2","layout":"vertical","gap":14,"width":300,"children":[{"type":"text","id":"ol-c2-h","content":"Part 1 · Exhaustive search · 2:41","fontSize":22,"fontWeight":"700","fill":"#3b82f6","textGrowth":"fixed-width","width":300},{"type":"note","id":"ol-c2-p0","width":300,"metadata":{"type":"decks.markdown"},"content":"Try all 4^7 = **16,384** policies and keep the best"},{"type":"note","id":"ol-c2-p1","width":300,"metadata":{"type":"decks.markdown"},"content":"The count explodes: chess has about 10^44 positions, Go 10^170"},{"type":"note","id":"ol-c2-p2","width":300,"metadata":{"type":"decks.markdown"},"content":"Wasteful: near-identical policies are tested from scratch, so share the work through **value**"}]},{"type":"frame","id":"ol-c3","layout":"vertical","gap":14,"width":300,"children":[{"type":"text","id":"ol-c3-h","content":"Part 1 · Value iteration · 3:55","fontSize":22,"fontWeight":"700","fill":"#3b82f6","textGrowth":"fixed-width","width":300},{"type":"note","id":"ol-c3-p0","width":300,"metadata":{"type":"decks.markdown"},"content":"**Value**: the reward you can expect from a square, discounted ×0.9 per step"},{"type":"note","id":"ol-c3-p1","width":300,"metadata":{"type":"decks.markdown"},"content":"**Bellman**: a square is worth the best reward plus 0.9 × the next square"},{"type":"note","id":"ol-c3-p2","width":300,"metadata":{"type":"decks.markdown"},"content":"Sweeps spread out from the cake: 10, 9, 8.1… done in 4 sweeps"},{"type":"note","id":"ol-c3-p3","width":300,"metadata":{"type":"decks.markdown"},"content":"The policy: step toward the best neighbour. But it needed **the map = the model** (and the robot eats the cake)"}]},{"type":"frame","id":"ol-c4","layout":"vertical","gap":14,"width":300,"children":[{"type":"text","id":"ol-c4-h","content":"Part 2 · Monte Carlo · 6:06","fontSize":22,"fontWeight":"700","fill":"#e8590c","textGrowth":"fixed-width","width":300},{"type":"note","id":"ol-c4-p0","width":300,"metadata":{"type":"decks.markdown"},"content":"Take the map away. Why it matters: **cars, robot hands, language models** can't foresee what comes next"},{"type":"note","id":"ol-c4-p1","width":300,"metadata":{"type":"decks.markdown"},"content":"The fog: from the corner, 1 time in 4 the zombie lurches up, and nobody tells the robot"},{"type":"note","id":"ol-c4-p2","width":300,"metadata":{"type":"decks.markdown"},"content":"Play whole trips and average what they earned: 5.9, −8.1, 7.29…"},{"type":"note","id":"ol-c4-p3","width":300,"metadata":{"type":"decks.markdown"},"content":"Judge, play a little better, repeat: **policy iteration** without a map. But it waits for every trip to end"}]},{"type":"frame","id":"ol-c5","layout":"vertical","gap":14,"width":300,"children":[{"type":"text","id":"ol-c5-h","content":"Part 2 · TD and Q-learning · 8:48","fontSize":22,"fontWeight":"700","fill":"#e8590c","textGrowth":"fixed-width","width":300},{"type":"note","id":"ol-c5-p0","width":300,"metadata":{"type":"decks.markdown"},"content":"**TD**: after each step, nudge toward reward + 0.9 × the next guess"},{"type":"note","id":"ol-c5-p1","width":300,"metadata":{"type":"decks.markdown"},"content":"One update: halfway to 10 is 5. Guesses learn from guesses and spread out from the cake"},{"type":"note","id":"ol-c5-p2","width":300,"metadata":{"type":"decks.markdown"},"content":"**10:22** Going up from the corner splits: ¾ empty square (8.1), ¼ zombie (−10), so Q is about 3, while right is about 7"},{"type":"note","id":"ol-c5-p3","width":300,"metadata":{"type":"decks.markdown"},"content":"**Q-learning**: a value for every move, with a max, so it's value iteration's twin (Watkins, 1989)"}]},{"type":"frame","id":"ol-c6","layout":"vertical","gap":14,"width":300,"children":[{"type":"text","id":"ol-c6-h","content":"The family · 11:43","fontSize":22,"fontWeight":"700","fill":"#6b7280","textGrowth":"fixed-width","width":300},{"type":"note","id":"ol-c6-p0","width":300,"metadata":{"type":"decks.markdown"},"content":"The family table: needs a map? waits for the end? which classic method is its counterpart?"},{"type":"note","id":"ol-c6-p1","width":300,"metadata":{"type":"decks.markdown"},"content":"Every method chases the same thing: **a policy**, learned from the difference between expected and got"},{"type":"note","id":"ol-c6-p2","width":300,"metadata":{"type":"decks.markdown"},"content":"> [!NOTE]\n> Being redrafted: two-by-two family map, the corner arrow turns right, cars and robots return"}]},{"type":"frame","id":"ol-c7","layout":"vertical","gap":14,"width":300,"children":[{"type":"text","id":"ol-c7-h","content":"Coda · 12:55","fontSize":22,"fontWeight":"700","fill":"#d92e3c","textGrowth":"fixed-width","width":300},{"type":"note","id":"ol-c7-p0","width":300,"metadata":{"type":"decks.markdown"},"content":"Blackout, glowing eyes, lightning: **Herobrine** on a hill with an enchanted diamond sword"},{"type":"note","id":"ol-c7-p1","width":300,"metadata":{"type":"decks.markdown"},"content":"“Learn… or die.” Glitch, then black"}]}],"x":7869,"y":137820},{"type":"text","id":"outline-title","content":"Four Ways to Find the Cake — outline, one point a card","fontSize":40,"fontWeight":"700","fill":"#6b7280","x":7869,"y":137740},{"type":"path","id":"xPYmP","name":"Ink","x":7732,"y":137786,"width":532,"height":441,"viewBox":[0,0,532,441],"geometry":"M446.3 154.1Q448.1 134.1 448 125.1Q447.8 116.1 446.7 110.2Q445.6 104.3 443.6 97.9Q441.5 91.5 439.1 85.6Q436.6 79.7 432.9 73.9Q429.1 68.1 425.2 63.3Q421.3 58.5 415.9 53.4Q410.5 48.3 404.2 44.2Q397.9 40 390.1 36.4Q382.3 32.8 373.6 29.3Q364.8 25.7 346.4 20.4Q328 15 313.5 12.2Q299 9.3 283.6 7.4Q268.2 5.4 256.6 4.8Q245 4.1 230.1 4.1Q215.1 4.1 200.1 5.1Q185.2 6 172.6 8.4Q160.1 10.7 144.2 14.6Q128.3 18.4 115.8 22.8Q103.2 27.2 92.6 31.9Q81.9 36.6 72.6 42.1Q63.3 47.6 55.1 54Q46.9 60.4 41.8 65.8Q36.7 71.2 30.8 79.2Q24.9 87.2 21.1 94.6Q17.3 101.9 14.5 109.7Q11.6 117.5 9.5 125.8Q7.4 134 6 142.8Q4.6 151.5 4.4 159.8Q4.1 168.1 4.1 177.3Q4.1 186.5 4.9 195.3Q5.7 204 7.6 212.3Q9.4 220.5 11.9 229.3Q14.3 238 17.8 246.8Q21.3 255.5 24.6 261.3Q27.9 267 35 277.4Q42 287.8 49.5 296.9Q57 305.9 65.8 314.6Q74.5 323.3 85.4 332.5Q96.2 341.7 108.6 350.5Q120.9 359.2 134.7 368Q148.4 376.7 163.2 384.8Q177.9 392.8 193.4 399.9Q208.8 406.9 223.8 412.9Q238.8 418.9 253.8 423.6Q268.7 428.2 283.7 431.2Q298.7 434.1 312.2 435.4Q325.7 436.7 339.2 436.4Q352.7 436.1 365.8 433.9Q378.8 431.7 389.5 427.9Q400.2 424 410.3 418.1Q420.4 412.1 429.7 404.6Q438.9 397 447.5 388.8Q456.1 380.5 464.8 370Q473.4