{
	"name": "@decks/canvas",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "The Decks canvas editor as a package: the stage, its camera, the drawing's editor and tools, and the canvas frame that holds them",
	"exports": {
		".": "./src/index.ts",
		"./comments": "./src/public/comments.ts",
		"./tools": "./src/public/tools.ts",
		"./camera": "./src/public/camera.ts",
		"./host": "./src/public/host.ts",
		"./card-reading": "./src/items/card-reading.ts",
		"./styles.css": "./styles/standalone.css",
		"./canvas.css": "./dist/canvas.css",
		"./styles/*": "./styles/*"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "node --import tsx --test \"src/**/*.test.ts\"",
		"build:css": "node scripts/build-css.mjs",
		"build:lib": "node ../../scripts/build-solid-lib.mjs ."
	},
	"dependencies": {
		"@decks/api": "*",
		"@decks/ink": "*",
		"@decks/pen": "*",
		"@decks/protocol": "*",
		"@decks/stage": "*",
		"@decks/ui": "*",
		"highlight.js": "^11.12.0",
		"lucide-solid": "^1.37.0",
		"marked": "^15.0.12",
		"mathjax-full": "^3.2.2",
		"solid-js": "^1.9.14",
		"@decks/hub": "*",
		"@decks/docs": "*"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.11",
		"@types/node": "^22.19.0",
		"@webgpu/types": "^0.1.74",
		"tailwindcss": "^4.1.11",
		"tsx": "^4.20.7",
		"typescript": "^5.9.3",
		"vite": "^7.1.9",
		"vite-plugin-solid": "^2.11.10"
	},
	"files": [
		"dist",
		"scripts",
		"src",
		"styles"
	]
}
