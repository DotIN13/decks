# opencode installs the tools' and plugin's own dependency into this directory the first time it
# loads them, and writes a lockfile beside it. Those are machine-local; the
# `package.json` that *declares* the dependency is not, so it stays tracked — a fresh clone
# has to say which version of `@opencode-ai/plugin` they are written against.
node_modules
package-lock.json
bun.lock
