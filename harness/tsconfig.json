{
	"extends": "../tsconfig.folder.json",
	"compilerOptions": {
		"types": [
			"node"
		],
		"jsx": "preserve",
		"jsxImportSource": "solid-js"
	},
	"include": [
		"**/*.ts",
		"**/*.tsx"
	],
	"exclude": [
		"page",
		"node_modules",
		"**/node_modules/**",
		"prompts/opencode/**",
		"prompts/opencode2/**",
		"prompts/antigravity/**"
	]
}
