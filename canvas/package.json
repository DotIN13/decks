{
	"name": "@decks/canvas",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "The Decks canvas editor as a package: the stage, its camera, the drawing's editor and tools, and the canvas frame that holds them",
	"exports": {
		".": "./index.ts",
		"./comments": "./public/comments.ts",
		"./tools": "./public/tools.ts",
		"./camera": "./public/camera.ts",
		"./host": "./public/host.ts",
		"./card-reading": "./items/card-reading.ts",
		"./card": "./items/card.ts",
		"./styles.css": "./styles/surface.css",
		"./surface.css": "./dist/surface.css",
		"./styles/*": "./styles/*",
		"./ink": "./ink/index.ts",
		"./cards-runtime": "./cards/runtime/index.ts",
		"./cards-runtime/sandbox": "./cards/runtime/sandbox.ts",
		"./cards-runtime/lib/*": "./cards/runtime/lib/*",
		"./documents": "./documents/model.ts"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "node --import tsx --test \"**/*.test.ts\"",
		"build:css": "node scripts/build-css.mjs",
		"build:lib": "node ../scripts/build-solid-lib.mjs .",
		"vendor": "node cards/runtime/vendor.mjs",
		"build:live-doc": "node documents/build-live-doc.mjs"
	},
	"dependencies": {
		"@decks/api": "*",
		"@decks/pen": "*",
		"@decks/protocol-old": "*",
		"@decks/engine": "*",
		"@decks/ui": "*",
		"highlight.js": "11.12.0",
		"lucide-solid": "^1.37.0",
		"marked": "15.0.12",
		"mathjax-full": "^3.2.2",
		"solid-js": "^1.9.14",
		"@decks/hub": "*",
		"d3": "7.9.0",
		"katex": "0.16.47",
		"mermaid": "11.17.2",
		"pdfjs-dist": "5.7.284",
		"diff": "^8.0.4",
		"docx-preview": "^0.4.1",
		"jszip": "^3.10.1"
	},
	"devDependencies": {
		"@types/node": "^22.19.0",
		"@webgpu/types": "^0.1.74",
		"tailwindcss": "^4.1.11",
		"tsx": "^4.20.7",
		"typescript": "^5.9.3",
		"vite": "^7.1.9"
	}
}
